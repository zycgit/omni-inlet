{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniInlet",
  "version": "0.2.0",
  "identifier": "net.hasor.omniinlet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniInlet",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
